# ─────────────────────────────────────────────────────────────────────────────
#  .env.example
#  Copia este archivo como .env y rellena los valores reales.
#  El .env NO se sube a git (está en .gitignore), y agents/policy_guard.py
#  bloquea que el asistente lo lea.
# ─────────────────────────────────────────────────────────────────────────────

# ── Proyecto ─────────────────────────────────────────────────────────────────
PROJECT_NAME="MeshHarmes"

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR

# ── Arnés ────────────────────────────────────────────────────────────────────
# Desactiva la puerta de permisos entera (solo para CI y automatismos):
# HARNESS_ASSUME_YES=1
# Embedder del RAG: onnx (por defecto, sin descargas) | multilingual
# HARNESS_RAG_EMBEDDER=onnx

# ── Servicios externos (descomenta lo que uses) ──────────────────────────────
# Gemini (Google) — gratis en ai.google.dev. La usa graphify para la extracción
# semántica; sin ella extrae solo estructura (AST), suficiente para código.
# GEMINI_API_KEY=AIza...

# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=mi_base
# DB_USER=usuario
# DB_PASSWORD=

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
